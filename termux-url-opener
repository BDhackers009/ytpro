#!/bin/bash
# ytpro - YouTube link handler for Termux.
# Termux runs this as: termux-url-opener "https://youtu.be/..."
#
# Flow: pick mode -> pick quality -> download -> progress -> result card -> exit.
set -u

URL=${1:-}
if [ -z "$URL" ]; then
	printf 'Usage: termux-url-opener <youtube-url>\n' >&2
	exit 1
fi

OUTDIR=/sdcard/YouTube
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/ytpro
LOG=$CACHE/last.log
CONFIRM_SIZE=${YTPRO_CONFIRM_SIZE:-1073741824}
YTDLP=$(command -v yt-dlp || true)
MPV=$(command -v mpv || true)

mkdir -p "$CACHE" 2>/dev/null
: >"$LOG" 2>/dev/null

WS=${TMPDIR:-${PREFIX:-/data/data/com.termux/files/usr}/tmp}
WORK=$(mktemp -d "$WS/ytpro.XXXXXX") || {
	printf 'ytpro: cannot create a temp directory\n' >&2
	exit 1
}
META=$WORK/meta.json
META_TSV=$WORK/meta.tsv
PATHS=$WORK/filepaths
FIFO=$WORK/progress
SPINDONE=$WORK/spin.done

cleanup() { rm -rf "$WORK"; }
trap cleanup EXIT

# ---------------------------------------------------------------- ui helpers
have() { command -v "$1" >/dev/null 2>&1; }

UI=${YTPRO_UI:-auto}
if [ "$UI" = auto ]; then
	if [ -t 0 ] && [ -t 1 ] && have gum && have dialog && [ -n "${TERM:-}" ]; then
		UI=gum
	else
		UI=plain
	fi
fi
TTY=0
[ -t 1 ] && TTY=1

if [ "$TTY" = 1 ]; then
	C0=$'\033[0m' CB=$'\033[1m' CC=$'\033[36m' CG=$'\033[32m' CR=$'\033[31m' CD=$'\033[2m'
else
	C0= CB= CC= CG= CR= CD=
fi

human_size() {
	awk -v b="${1:-0}" 'BEGIN {
		if (b <= 0) { print "unknown"; exit }
		split("B KB MB GB TB", u, " "); i = 1
		while (b >= 1024 && i < 5) { b /= 1024; i++ }
		if (i == 1) printf "%.0f %s\n", b, u[i]
		else printf "%.1f %s\n", b, u[i]
	}'
}

fmt_dur() {
	local s=${1:-0}
	[ "$s" -ge 0 ] 2>/dev/null || s=0
	if [ "$s" -ge 3600 ]; then
		printf '%dh %02dm' $((s / 3600)) $(((s % 3600) / 60))
	elif [ "$s" -ge 60 ]; then
		printf '%dm %02ds' $((s / 60)) $((s % 60))
	else
		printf '%ds' "$s"
	fi
}

fmt_count() {
	awk -v n="${1:-0}" 'BEGIN {
		if (n >= 1000000000) printf "%.1fB", n/1000000000
		else if (n >= 1000000) printf "%.1fM", n/1000000
		else if (n >= 1000) printf "%.1fK", n/1000
		else printf "%d", n
	}'
}

notify() {
	if have termux-toast; then termux-toast "$1" >/dev/null 2>&1 || true; fi
}

msgbox() { # title, body
	local title=$1 body=$2
	if [ "$UI" = gum ] && [ "$TTY" = 1 ] && have dialog; then
		dialog --title "$title" --msgbox "$body" 22 78
		return
	fi
	if [ "$UI" = gum ]; then
		printf '%s\n' "$body" | gum style --border rounded --border-foreground 51 --padding '0 1' --margin '1 0'
	else
		printf '\n%s%s%s\n%s\n' "$CB" "$title" "$C0" "$body"
	fi
	if [ "$TTY" = 1 ]; then
		printf '\nPress Enter to continue...'
		read -r _ || true
	fi
}

choose() { # header, items... ; prints the chosen item
	local header=$1
	shift
	local -a items=("$@")
	if [ "${#items[@]}" -eq 0 ]; then return 1; fi
	if [ "$UI" = gum ]; then
		printf '%s\n' "${items[@]}" |
			gum choose --header "$header" --height 20 --cursor '❯ ' --cursor.foreground 51
		return
	fi
	printf '\n%s%s%s\n' "$CC" "$header" "$C0" >&2
	local i
	for i in "${!items[@]}"; do
		printf '  %2d) %s\n' "$((i + 1))" "${items[$i]}" >&2
	done
	local n line
	while :; do
		printf 'Select [1-%d, default 1]: ' "${#items[@]}" >&2
		read -r line || line=""
		[ -z "$line" ] && line=1
		case $line in
		'' | *[!0-9]*) printf 'Enter a number.\n' >&2; continue ;;
		esac
		if [ "$line" -ge 1 ] && [ "$line" -le "${#items[@]}" ]; then
			n=$line
			break
		fi
		printf 'Enter 1-%d.\n' "${#items[@]}" >&2
	done
	printf '%s\n' "${items[$((n - 1))]}"
}

confirm() { # question, default no
	local q=$1
	if [ "$UI" = gum ]; then
		gum confirm "$q"
		return
	fi
	printf '%s [y/N] ' "$q"
	local a=""
	read -r a || true
	case $a in y | Y | yes | YES) return 0 ;; *) return 1 ;; esac
}

show_log() {
	if [ "$UI" = gum ] && [ "$TTY" = 1 ] && have dialog; then
		dialog --title "ytpro log" --textbox "$LOG" 24 78
	else
		printf '\n%s--- log (%s) ---%s\n' "$CD" "$LOG" "$C0"
		tail -n 25 "$LOG" 2>/dev/null
	fi
}

# ------------------------------------------------------------------ metadata
parse_meta() {
	python3 - "$META" <<'PY'
import json, sys

try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        m = json.load(fh)
except Exception:
    sys.exit(2)

def clean(s):
    return " ".join(str(s or "").split())

def fsize(f):
    return f.get("filesize") or f.get("filesize_approx") or 0

def fps(f):
    try:
        return round(float(f.get("fps") or 0))
    except Exception:
        return 0

def vrank(c):
    c = (c or "").lower()
    if c.startswith("avc"):
        return 0
    if c.startswith("av01"):
        return 1
    if c.startswith("vp9") or c.startswith("vp09"):
        return 2
    return 3

def vname(c):
    c = (c or "").lower()
    if c.startswith("avc"):
        return "h264"
    if c.startswith("av01"):
        return "av1"
    if c.startswith("vp9") or c.startswith("vp09"):
        return "vp9"
    if not c or c == "none":
        return "-"
    return c.split(".")[0][:8]

def aname(c):
    c = (c or "").lower()
    if c.startswith("mp4a"):
        return "m4a"
    if c.startswith("opus"):
        return "opus"
    if c.startswith("vorbis"):
        return "vorbis"
    return c.split(".")[0][:8] or "-"

def is_m4a(c):
    return (c or "").lower().startswith("mp4a")

formats = m.get("formats") or []
vids = [
    f for f in formats
    if f.get("vcodec") not in (None, "none") and f.get("ext") not in ("mhtml", "")
]
auds = [
    f for f in formats
    if f.get("vcodec") in (None, "none")
    and f.get("acodec") not in (None, "none")
    and f.get("ext") not in ("mhtml", "")
]

best_audio = None
for f in sorted(auds, key=lambda f: (-(f.get("abr") or 0), 0 if is_m4a(f.get("acodec")) else 1)):
    best_audio = f
    break
best_m4a = None
for f in sorted(auds, key=lambda f: (-(f.get("abr") or 0), -fsize(f))):
    if is_m4a(f.get("acodec")):
        best_m4a = f
        break
video_audio = best_m4a or best_audio

groups = {}
for f in vids:
    groups.setdefault((f.get("height") or 0, fps(f)), []).append(f)

rows = []
for (h, fr), fs in groups.items():
    fs.sort(key=lambda f: (vrank(f.get("vcodec")), 0 if fsize(f) else 1, -fsize(f)))
    f = fs[0]
    muxed = f.get("acodec") not in (None, "none")
    aid = "" if muxed else ((video_audio or {}).get("format_id") or "")
    total = fsize(f)
    if aid and video_audio:
        total += fsize(video_audio)
    rows.append((h, fr, vname(f.get("vcodec")), f.get("ext") or "?", total, f.get("format_id"), aid))
rows.sort(key=lambda r: (-r[0], -r[1]))

title = clean(m.get("title"))
uploader = clean(m.get("uploader") or m.get("channel"))
print("H\t%s\t%s\t%d\t%d\t%d" % (
    title, uploader, int(m.get("duration") or 0),
    int(m.get("view_count") or 0), 1 if m.get("is_live") else 0,
))
for r in rows:
    print("V\t%d\t%d\t%s\t%s\t%d\t%s\t%s" % r)
for a in sorted(auds, key=lambda f: (-(f.get("abr") or 0), 0 if is_m4a(f.get("acodec")) else 1, -fsize(f))):
    print("A\t%s\t%.1f\t%s\t%s\t%d" % (
        a.get("format_id"), a.get("abr") or 0, aname(a.get("acodec")),
        a.get("ext") or "?", fsize(a),
    ))
PY
}

fetch_meta() {
	if [ "$UI" = gum ]; then
		gum spin --spinner minidot --title " Fetching available formats " -- \
			"$YTDLP" -J --no-playlist --no-warnings "$URL" >"$META" 2>>"$LOG"
	else
		printf 'Fetching available formats...\n' >&2
		"$YTDLP" -J --no-playlist --no-warnings "$URL" >"$META" 2>>"$LOG"
	fi
}

load_meta() {
	parse_meta >"$META_TSV" 2>>"$LOG" || return 1
	TITLE="" UPLOADER="" DURATION=0 VIEWS=0 LIVE=0
	V_H=() V_FPS=() V_CODEC=() V_EXT=() V_SIZE=() V_ID=() V_AID=()
	A_ID=() A_ABR=() A_CODEC=() A_EXT=() A_SIZE=()
	while IFS=$'\t' read -r tag f1 f2 f3 f4 f5 f6 f7; do
		case $tag in
		H) TITLE=$f1 UPLOADER=$f2 DURATION=$f3 VIEWS=$f4 LIVE=$f5 ;;
		V)
			V_H+=("$f1") V_FPS+=("$f2") V_CODEC+=("$f3") V_EXT+=("$f4")
			V_SIZE+=("$f5") V_ID+=("$f6") V_AID+=("$f7")
			;;
		A)
			A_ID+=("$f1") A_ABR+=("$f2") A_CODEC+=("$f3") A_EXT+=("$f4") A_SIZE+=("$f5")
			;;
		esac
	done <"$META_TSV"
	[ "${#V_ID[@]}" -gt 0 ] || [ "${#A_ID[@]}" -gt 0 ]
}

show_header() {
	local line1="$TITLE"
	local line2="$UPLOADER"
	[ -n "$UPLOADER" ] && line2="$UPLOADER  ·  $(fmt_dur "$DURATION")  ·  $(fmt_count "$VIEWS") views"
	[ "$LIVE" = 1 ] && line2="$line2  ·  ${CR}LIVE${C0}"
	if [ "$UI" = gum ]; then
		printf '%s\n%s\n' "$line1" "$line2" |
			gum style --border rounded --border-foreground 51 --padding '0 1'
	else
		printf '\n%s%s%s\n%s%s%s\n' "$CB" "$line1" "$C0" "$CD" "$line2" "$C0"
	fi
}

# ------------------------------------------------------------------ download
as_int() {
	local v=${1:-0}
	case $v in
	'' | NA | None | null) printf '0' ;;
	*[!0-9.]*) printf '0' ;;
	*)
		v=${v%%.*}
		[ -n "$v" ] || v=0
		printf '%s' "$v"
		;;
	esac
}

render_bar() { # status downloaded total speed eta
	local status=$1 dl total speed eta
	dl=$(as_int "$2")
	total=$(as_int "$3")
	speed=$(as_int "$4")
	eta=$(as_int "$5")
	[ "$TTY" = 1 ] || return 0
	if [ "$total" -gt 0 ] && [ "$dl" -gt "$total" ]; then total=$dl; fi
	local now elapsed
	now=$(date +%s 2>/dev/null || echo 0)
	elapsed=$((now - ${DL_START:-$now}))
	[ "$elapsed" -lt 1 ] && elapsed=1
	if [ "$speed" -le 0 ] && [ "$dl" -gt 0 ]; then speed=$((dl / elapsed)); fi
	if [ "$total" -gt 0 ] && [ "$speed" -gt 0 ] && [ "$eta" -le 0 ] && [ "$dl" -lt "$total" ]; then
		eta=$(((total - dl) / speed))
	fi

	local pct=0 width=${COLUMNS:-50}
	case $width in '' | *[!0-9]*) width=50 ;; esac
	[ "$width" -gt 40 ] && width=40
	[ "$width" -lt 20 ] && width=20
	width=$((width / 2))
	if [ "$total" -gt 0 ]; then pct=$((dl * 100 / total)); fi
	[ "$pct" -gt 100 ] && pct=100
	if [ "$status" = finished ]; then pct=100; fi
	local filled=$((pct * width / 100))
	local bar pad
	printf -v bar '%*s' "$filled" ''
	printf -v pad '%*s' "$((width - filled))" ''
	bar=${bar// /#}
	pad=${pad// /-}
	local sp="" eta_s=""
	[ "$speed" -gt 0 ] && sp="$(human_size "$speed")/s  "
	if [ "$eta" -gt 0 ] && [ "$pct" -lt 100 ]; then
		eta_s="ETA $(fmt_dur "$eta")  "
	fi
	local detail
	if [ "$total" -gt 0 ]; then
		detail="$(human_size "$dl") / $(human_size "$total")"
	else
		detail="$(human_size "$dl")"
	fi
	printf '\r%s[%s%s] %3d%%  %s%s%s%s' "$CC" "$bar" "$pad" "$pct" "$sp" "$eta_s" "$detail" "$C0"
}

start_spin() {
	[ "$TTY" = 1 ] || return 0
	(
		i=0
		s='|/-\'
		while [ ! -e "$SPINDONE" ]; do
			printf '\r%s Finalizing (merge/convert)... ' "${s:i%4:1}"
			i=$((i + 1))
			sleep 0.15
		done
		printf '\r\033[K'
	) &
	SPINPID=$!
}

stop_spin() {
	[ -n "${SPINPID:-}" ] || return 0
	touch "$SPINDONE"
	wait "$SPINPID" 2>/dev/null || true
	SPINPID=""
}

run_download() { # format, extra args...
	FORMAT=$1
	shift
	local -a extra=("$@")
	local -a args=()
	[ "$LIVE" = 1 ] && args+=(--live-from-start)
	if [ "$PLAYLIST" = 1 ]; then
		args+=(--yes-playlist)
	else
		args+=(--no-playlist)
	fi
	args+=(-f "$FORMAT")
	[ "${#extra[@]}" -gt 0 ] && args+=("${extra[@]}")
	args+=(--newline
		--progress-template 'YTPROG|%(progress.status)s|%(progress.downloaded_bytes)s|%(progress.total_bytes)s|%(progress.total_bytes_estimate)s|%(progress.speed)s|%(progress.eta)s'
		--print-to-file 'after_move:filepath' "$PATHS"
		"$URL")

	rm -f "$PATHS" "$FIFO" "$SPINDONE"
	mkfifo "$FIFO" || return 1
	SPINPID=""
	FINALIZE_SHOWN=0
	DL_START=$(date +%s)

	"$YTDLP" "${args[@]}" >"$FIFO" 2>>"$LOG" &
	local pid=$!
	local line status dl tb tbe total speed eta
	while IFS= read -r line; do
		case $line in
		YTPROG\|*)
			IFS='|' read -r _ status dl tb tbe speed eta <<<"$line"
			total=$(as_int "$tb")
			[ "$total" -gt 0 ] || total=$(as_int "$tbe")
			render_bar "$status" "$dl" "$total" "$speed" "$eta"
			if [ "$status" = finished ] && [ "$FINALIZE_SHOWN" = 0 ]; then
				[ "$TTY" = 1 ] && printf '\n'
				FINALIZE_SHOWN=1
				start_spin
			fi
			;;
		*) printf '%s\n' "$line" >>"$LOG" ;;
		esac
	done <"$FIFO"

	wait "$pid"
	local rc=$?
	stop_spin
	[ "$TTY" = 1 ] && printf '\n'
	return "$rc"
}

last_error() {
	grep -a 'ERROR:' "$LOG" 2>/dev/null | tail -n 1 | sed 's/^ERROR: //'
}

result_path() {
	[ -s "$PATHS" ] || return 1
	head -n 1 "$PATHS"
}

result_size() {
	local f=$1
	if [ -n "$f" ] && [ -f "$f" ]; then
		stat -c %s "$f" 2>/dev/null || echo 0
	else
		echo 0
	fi
}

card_menu() { # title, summary, tag description... ; prints the tag
	local title=$1 summary=$2
	shift 2
	local -a tags=() dlg=()
	while [ "$#" -gt 0 ]; do
		tags+=("$1")
		dlg+=("$1" "${2:-}")
		shift 2
	done
	[ "${#tags[@]}" -gt 0 ] || return 1
	if [ "$UI" = gum ] && [ "$TTY" = 1 ] && have dialog; then
		local action
		action=$(dialog --title "$title" --menu "$summary" 24 78 10 "${dlg[@]}" 3>&1 1>&2 2>&3) || action=""
		[ -z "$action" ] && action=${tags[0]}
		printf '%s\n' "$action"
	else
		printf '\n%s%s%s\n%s\n' "$CB" "$title" "$C0" "$summary" >&2
		choose "$title" "${tags[@]}"
	fi
}

finish_card() { # summary
	local summary=$1
	shift
	while :; do
		local action
		if [ "${PLAYLIST:-0}" = 1 ]; then
			action=$(card_menu "Download complete" "$summary" \
				"Done" "Exit ytpro" \
				"Log" "Show log") || action=Done
		else
			action=$(card_menu "Download complete" "$summary" \
				"Done" "Exit ytpro" \
				"Play" "Open in player" \
				"Copy" "Copy path" \
				"Log" "Show log") || action=Done
		fi
		case $action in
		Play)
			if [ -n "${FILE:-}" ] && [ -f "${FILE:-}" ] && have termux-open; then
				termux-open "$FILE" >/dev/null 2>&1 || notify "No app can open this file"
			elif [ -n "${FILE:-}" ]; then
				notify "File not found: $FILE"
			fi
			;;
		Copy)
			if [ -n "${FILE:-}" ] && have termux-clipboard-set; then
				termux-clipboard-set "$FILE" >/dev/null 2>&1 && notify "Path copied"
			else
				notify "Clipboard unavailable"
			fi
			;;
		Log) show_log ;;
		*) break ;;
		esac
	done
}

error_card() { # summary ; prints Retry|Log|Exit
	local summary=$1
	card_menu "Download failed" "$summary" \
		"Retry" "Try the same download again" \
		"Log" "Show log" \
		"Exit" "Exit ytpro"
}

cancel_card() { msgbox "Cancelled" "Download cancelled."; }

finish() { # exit code
	local code=${1:-0}
	if [ "${YTPRO_NO_EXIT:-0}" = 1 ]; then
		return "$code"
	fi
	exit "$code"
}

# ---------------------------------------------------------------------- main
main() {
	if [ -z "$YTDLP" ]; then
		msgbox "ytpro" $'yt-dlp is not installed.\nRun tuo-install.sh in the ytpro folder.'
		finish 1
		return
	fi

	if ! fetch_meta; then
		msgbox "ytpro" "Could not read video information.

$(last_error)"
		show_log
		finish 1
		return
	fi

	if ! load_meta; then
		msgbox "ytpro" "No downloadable formats were found for this link."
		show_log
		finish 1
		return
	fi

	show_header

	PLAYLIST=0
	case $URL in *list=*) PLAYLIST=1 ;; esac
	if [ "$PLAYLIST" = 1 ]; then
		local scope
		scope=$(choose "This link is part of a playlist" "This video only" "Whole playlist") || scope="This video only"
		[ "$scope" = "Whole playlist" ] || PLAYLIST=0
	fi

	local mode
	mode=$(choose "What do you want to do?" \
		"Play audio (stream, no download)" \
		"Download video" \
		"Download audio") || mode="Play audio (stream, no download)"

	if [ "$mode" = "Play audio (stream, no download)" ]; then
		if [ -z "$MPV" ]; then
			msgbox "ytpro" $'mpv is not installed.\nRun tuo-install.sh in the ytpro folder.'
			finish 1
			return
		fi
		"$MPV" "$URL" 2>>"$LOG"
		msgbox "Playback ended" "mpv has exited."
		finish 0
		return
	fi

	# ------------------------------ video
	if [ "$mode" = "Download video" ]; then
		if [ "${#V_ID[@]}" -eq 0 ]; then
			msgbox "ytpro" "No video formats were found for this link."
			finish 1
			return
		fi
		local -a labels=() ids=() aids=() sizes=()
		local i
		labels+=("Best available — ${V_H[0]}p · ${V_CODEC[0]} · $(human_size "${V_SIZE[0]}")")
		ids+=("${V_ID[0]}") aids+=("${V_AID[0]}") sizes+=("${V_SIZE[0]}")
		for i in "${!V_ID[@]}"; do
			local fps_txt=""
			[ "${V_FPS[$i]}" -ge 50 ] 2>/dev/null && fps_txt=" · ${V_FPS[$i]}fps"
			labels+=("${V_H[$i]}p${fps_txt} · ${V_CODEC[$i]} · ${V_EXT[$i]} · $(human_size "${V_SIZE[$i]}")")
			ids+=("${V_ID[$i]}") aids+=("${V_AID[$i]}") sizes+=("${V_SIZE[$i]}")
		done

		local pick idx
		if [ "$PLAYLIST" = 1 ]; then
			pick=""
		else
			pick=$(choose "Video quality — $TITLE" "${labels[@]}") || pick="${labels[0]}"
		fi
		idx=0
		if [ -n "$pick" ]; then
			for i in "${!labels[@]}"; do
				if [ "${labels[$i]}" = "$pick" ]; then idx=$i; break; fi
			done
		fi

		local fmt v id aid size
		if [ "$PLAYLIST" = 1 ]; then
			fmt="bv*+ba/b"
			id="playlist"
			aid=""
			size=0
		else
			id=${ids[$idx]} aid=${aids[$idx]} size=${sizes[$idx]}
			if [ -n "$aid" ]; then
				fmt="${id}+${aid}"
			else
				fmt="${id}"
			fi
		fi

		if [ "$size" -ge "$CONFIRM_SIZE" ] 2>/dev/null; then
			confirm "This download is about $(human_size "$size"). Continue?" || {
				cancel_card
				finish 0
				return
			}
		fi

		local quality
		if [ "$PLAYLIST" = 1 ]; then
			quality="Whole playlist · best quality"
		else
			quality=${labels[$idx]}
		fi
		local -a merge=()
		if [ -n "$aid" ] || [ "$PLAYLIST" = 1 ]; then
			merge=(--merge-output-format mp4)
		fi

		SECONDS=0
		while :; do
			CANCELLED=0
			run_download "$fmt" "${merge[@]}"
			local rc=$?
			if [ "${CANCELLED:-0}" = 1 ] || [ "$rc" = 130 ]; then
				cancel_card
				finish 130
				return
			fi
			FILE=$(result_path || true)
			if [ "$rc" = 0 ]; then
				local bytes summary sizetxt
				bytes=$(result_size "${FILE:-}")
				if [ "$PLAYLIST" = 1 ]; then
					FILE=""
					sizetxt="playlist"
				else
					sizetxt=$(human_size "$bytes")
				fi
				summary=$(printf 'Title   : %s\nQuality : %s\nSize    : %s\nTime    : %ss\nPath    : %s' \
					"$TITLE" "$quality" "$sizetxt" "$SECONDS" "${FILE:-$OUTDIR/}")
				notify "Download complete"
				finish_card "$summary"
				finish 0
				return
			fi
			local action esummary
			esummary=$(printf 'Quality : %s\n\n%s\n\nLog: %s' "$quality" "$(last_error)" "$LOG")
			while :; do
				action=$(error_card "$esummary") || action=Exit
				case $action in
				Retry) break ;;
				Log) show_log ;;
				*) finish 1; return ;;
				esac
			done
		done
	fi

	# ------------------------------ audio
	local -a alabels=() akind=() aid2=() aq=() asize=()
	local i
	if [ "${#A_ID[@]}" -gt 0 ]; then
		alabels+=("Best native — ${A_ABR[0]}k ${A_CODEC[0]} · $(human_size "${A_SIZE[0]}")")
		akind+=("native") aid2+=("${A_ID[0]}") aq+=("") asize+=("${A_SIZE[0]}")
		for i in "${!A_ID[@]}"; do
			alabels+=("${A_ABR[$i]}k ${A_CODEC[$i]} · ${A_EXT[$i]} · $(human_size "${A_SIZE[$i]}")")
			akind+=("native") aid2+=("${A_ID[$i]}") aq+=("") asize+=("${A_SIZE[$i]}")
		done
	fi
	for i in 320 192 128; do
		alabels+=("MP3 ${i}k (re-encode)")
		akind+=("mp3") aid2+=("") aq+=("$i") asize+=("0")
	done
	if [ "${#alabels[@]}" -eq 0 ]; then
		msgbox "ytpro" "No audio formats were found for this link."
		finish 1
		return
	fi

	local apick aidx
	apick=$(choose "Audio quality — $TITLE" "${alabels[@]}") || apick="${alabels[0]}"
	aidx=0
	for i in "${!alabels[@]}"; do
		if [ "${alabels[$i]}" = "$apick" ]; then aidx=$i; break; fi
	done

	local afmt aquality
	local -a aextra=()
	if [ "${akind[$aidx]}" = mp3 ]; then
		afmt="ba"
		aquality="MP3 ${aq[$aidx]}k"
		aextra=(-x --audio-format mp3 --audio-quality "${aq[$aidx]}K")
	elif [ "$PLAYLIST" = 1 ]; then
		afmt="ba"
		aquality="Whole playlist · best audio"
	else
		afmt=${aid2[$aidx]}
		aquality=${alabels[$aidx]}
	fi

	SECONDS=0
	while :; do
		CANCELLED=0
		run_download "$afmt" "${aextra[@]}"
		local rc=$?
		if [ "${CANCELLED:-0}" = 1 ] || [ "$rc" = 130 ]; then
			cancel_card
			finish 130
			return
		fi
		FILE=$(result_path || true)
		if [ "$rc" = 0 ]; then
			local bytes summary sizetxt
			bytes=$(result_size "${FILE:-}")
			if [ "$PLAYLIST" = 1 ]; then
				FILE=""
				sizetxt="playlist"
			else
				sizetxt=$(human_size "$bytes")
			fi
			summary=$(printf 'Title   : %s\nQuality : %s\nSize    : %s\nTime    : %ss\nPath    : %s' \
				"$TITLE" "$aquality" "$sizetxt" "$SECONDS" "${FILE:-$OUTDIR/}")
			notify "Download complete"
			finish_card "$summary"
			finish 0
			return
		fi
		local action esummary
		esummary=$(printf 'Quality : %s\n\n%s\n\nLog: %s' "$aquality" "$(last_error)" "$LOG")
		while :; do
			action=$(error_card "$esummary") || action=Exit
			case $action in
			Retry) break ;;
			Log) show_log ;;
			*) finish 1; return ;;
			esac
		done
	done
}

CANCELLED=0
trap 'CANCELLED=1' INT

main "$@"
